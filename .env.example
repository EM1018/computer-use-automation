# Copy this file to .env and fill in your own values. .env is gitignored —
# nothing here ever gets committed.

# Required for anything that calls the real model: `npm run discover`,
# `npm run discover:e2e`. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Only needed if the key above is scoped to the whole organization rather
# than one workspace — such a key must specify which workspace's
# budget/rate limits to use. If you see an error like "This API key is not
# scoped to a workspace, so this request must include the
# anthropic-workspace-id header", find the workspace ID at
# console.anthropic.com under Settings > Workspaces and paste it here.
# ANTHROPIC_WORKSPACE_ID=

# Required for anything that logs into the target app: replay, the demo
# scripts, and discover. Must match the operator credentials the target app
# (app.py) was started with — its own OPERATOR_USER/OPERATOR_PASS env vars,
# defaulting to "operator"/"changeme123" if you didn't set those either.
FCU_OPERATOR_USER=operator
FCU_OPERATOR_PASS=changeme123

# Optional overrides — uncomment to change from the defaults.
# HEADLESS=1                # run browsers headless instead of headed
# TARGET_BASE_URL=http://127.0.0.1:5001   # used by `discover` (not the demo scripts, which start their own app)
# DISCOVERY_MODEL=claude-sonnet-5
# OPERATOR_PORT=4545
